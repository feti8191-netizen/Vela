// Lexical closures and higher-order functions
make_adder(n) ==> (x) ==> x + n;
add5 := make_adder(5);
print(add5(10));

make_counter() ==> {
    c <- 0;
    -> () ==> {
        c <- c + 1;
        -> c;
    };
};
ctr := make_counter();
print(ctr(), ctr(), ctr());

// Classic fib via recursion
fib(n) ==> {
    when n < 2 { -> n; }
    -> fib(n - 1) + fib(n - 2);
};
print("fib(10) =", fib(10));
