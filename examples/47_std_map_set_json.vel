import "std/map.vel" as Map;
import "std/set.vel" as Set;
import "std/json.vel" as JSON;

m := %{name: "Ada", age: 36};
print(Map.get(m, "name"));
print(Map.get(m, "missing", "n/a"));
print(Map.has_key(m, "age"));

a := #{1, 2, 3};
b := #{2, 3, 4};
print(Set.common(a, b));
print(Set.has_item(a, 1));

j := JSON.stringify(%{ok: true, n: 1});
print(j);
print(JSON.parse(j));
