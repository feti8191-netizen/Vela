// std/stats — simple list statistics
mean(xs) ==> {
    when len(xs) == 0 { -> nil; }
    else { -> sum(xs) / len(xs); }
};
min_of(xs) ==> {
    when len(xs) == 0 { -> nil; }
    else {
        m <- xs[0];
        repeat x in xs {
            when x < m { m <- x; }
        }
        -> m;
    }
};
max_of(xs) ==> {
    when len(xs) == 0 { -> nil; }
    else {
        m <- xs[0];
        repeat x in xs {
            when x > m { m <- x; }
        }
        -> m;
    }
};
sum_sq(xs) ==> {
    t <- 0;
    repeat x in xs {
        t <- t + x * x;
    }
    -> t;
};
count(xs) ==> len(xs);
